<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prompt Engineer - Job Application</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="wrap">

    <!-- START SCREEN -->
    <div id="startScreen">
      <div class="terminal-tag"><span class="cursor"></span> hiring/prompt-engineer</div>
      <h1>Prompt Engineer Application</h1>
      <p class="subtitle">This application includes a resume upload and 15 optional questions about prompt engineering. Once you click Start, a 15-minute timer begins and the form will auto-submit when time runs out — so make sure you're ready before starting.</p>
      <div class="card start-card">
        <div class="start-info">
          <div class="start-info-item">
            <div class="start-info-label">Questions</div>
            <div class="start-info-value">15 (optional)</div>
          </div>
          <div class="start-info-item">
            <div class="start-info-label">Resume</div>
            <div class="start-info-value">Required</div>
          </div>
          <div class="start-info-item">
            <div class="start-info-label">Time limit</div>
            <div class="start-info-value">15 minutes</div>
          </div>
        </div>
        <button type="button" id="startBtn" class="btn-accent">Start Application &rarr;</button>
      </div>
    </div>

    <!-- FORM SCREEN (hidden until Start is clicked) -->
    <div id="formScreen" style="display:none;">
      <div class="timer-bar" id="timerBar">
        <span class="timer-dot"></span>
        <span id="timerDisplay">15:00</span>
        <span class="timer-label">time remaining</span>
      </div>

      <div id="autoSubmitNotice" class="auto-submit-notice" style="display:none;">
        &#9203; Time's up — submitting your application now...
      </div>

      <h1>Prompt Engineer Application</h1>
      <p class="subtitle">Fill in your details below. Resume upload is required — all other questions are optional, answer as many as you can.</p>

      <% if (error) { %>
        <div class="error-box"><%= error %></div>
      <% } %>

      <form action="/submit" method="POST" enctype="multipart/form-data" id="applicationForm">
        <input type="hidden" name="timeTaken" id="timeTakenInput" value="0">

        <div class="card">
          <div class="section-title">Basic Details</div>
          <div class="field">
            <label class="required">Full Name</label>
            <input type="text" name="name" required>
          </div>
          <div class="field">
            <label class="required">Email</label>
            <input type="email" name="email" required>
          </div>
          <div class="field">
            <label>Phone Number</label>
            <input type="tel" name="phone">
          </div>
        </div>

        <div class="card">
          <div class="section-title">Resume</div>
          <div class="field">
            <label class="required">Resume Upload (PDF / DOC / DOCX, max 5MB)</label>
            <div class="file-drop">
              <input type="file" name="resume" accept=".pdf,.doc,.docx" required>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="section-title">Prompt Engineering Questions <span class="optional-tag">(all optional)</span></div>
          <% questions.forEach((q, i) => { %>
            <div class="field">
              <div class="q-line">
                <span class="q-num">Q<%= String(i+1).padStart(2,'0') %></span>
                <span class="q-text"><%= q %> <span class="optional-tag">(optional)</span></span>
              </div>
              <textarea name="q<%= i %>" placeholder="Type your answer here..." class="answer-box" data-index="<%= i %>"></textarea>
              <div class="char-count" id="charCount<%= i %>">0 characters</div>
            </div>
          <% }) %>
        </div>

        <button type="submit" class="btn-accent" id="submitBtn">Submit Application &rarr;</button>
      </form>
    </div>
  </div>

  <script>
    const TIME_LIMIT_SECONDS = 15 * 60; // change this number to adjust the time limit

    const startScreen = document.getElementById('startScreen');
    const formScreen = document.getElementById('formScreen');
    const startBtn = document.getElementById('startBtn');
    const timerBar = document.getElementById('timerBar');
    const timerDisplay = document.getElementById('timerDisplay');
    const timeTakenInput = document.getElementById('timeTakenInput');
    const applicationForm = document.getElementById('applicationForm');
    const submitBtn = document.getElementById('submitBtn');
    const autoSubmitNotice = document.getElementById('autoSubmitNotice');

    let startTime = null;
    let timerInterval = null;
    let autoSubmitted = false;

    function formatTime(totalSeconds) {
      const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
      const s = (totalSeconds % 60).toString().padStart(2, '0');
      return m + ':' + s;
    }

    function tick() {
      const elapsed = Math.floor((Date.now() - startTime) / 1000);
      const remaining = TIME_LIMIT_SECONDS - elapsed;

      if (remaining <= 0) {
        clearInterval(timerInterval);
        timerDisplay.textContent = '00:00';
        timeTakenInput.value = TIME_LIMIT_SECONDS;
        autoSubmitted = true;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';
        autoSubmitNotice.style.display = 'block';
        window.scrollTo(0, 0);
        setTimeout(() => applicationForm.submit(), 800);
        return;
      }

      timerDisplay.textContent = formatTime(remaining);
      if (remaining <= 120) {
        timerBar.classList.add('timer-warning');
      }
    }

    startBtn.addEventListener('click', () => {
      startScreen.style.display = 'none';
      formScreen.style.display = 'block';
      startTime = Date.now();
      timerInterval = setInterval(tick, 1000);
      window.scrollTo(0, 0);
    });

    applicationForm.addEventListener('submit', () => {
      if (startTime && !autoSubmitted) {
        const elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
        timeTakenInput.value = elapsedSeconds;
      }
      if (timerInterval) clearInterval(timerInterval);
    });

    // Live character count per answer
    document.querySelectorAll('.answer-box').forEach(box => {
      box.addEventListener('input', () => {
        const i = box.getAttribute('data-index');
        const count = box.value.length;
        document.getElementById('charCount' + i).textContent = count + ' characters';
      });
    });
  </script>
</body>
</html>