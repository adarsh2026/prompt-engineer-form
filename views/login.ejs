<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="wrap" style="max-width: 420px; padding-top: 100px;">
    <div class="terminal-tag"><span class="cursor"></span> admin/login</div>
    <h1 style="font-size: 24px;">Admin Login</h1>
    <p class="subtitle">Enter the password to view candidates.</p>

    <% if (error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>

    <form action="/admin/login" method="POST" class="card">
      <div class="field">
        <label class="required">Password</label>
        <input type="password" name="password" required autofocus>
      </div>
      <button type="submit" class="btn-accent" style="width:100%;">Login</button>
    </form>
  </div>
</body>
</html>